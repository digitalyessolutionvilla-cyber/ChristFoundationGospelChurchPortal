-- Media Library tracking table
CREATE TABLE IF NOT EXISTS media_library (
  id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
  filename TEXT NOT NULL,
  storage_path TEXT NOT NULL,
  public_url TEXT NOT NULL,
  file_type TEXT NOT NULL DEFAULT 'image',
  file_size INT DEFAULT 0,
  alt_text TEXT DEFAULT '',
  caption TEXT DEFAULT '',
  folder TEXT DEFAULT 'general',
  uploaded_by UUID REFERENCES auth.users(id) ON DELETE SET NULL,
  created_at TIMESTAMPTZ DEFAULT NOW()
);
ALTER TABLE media_library ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read media" ON media_library FOR SELECT USING (true);
CREATE POLICY "Authenticated manage media" ON media_library FOR ALL USING (auth.role() = 'authenticated');

-- News Categories
CREATE TABLE IF NOT EXISTS news_categories (
  id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
  name TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  color TEXT DEFAULT '#1e3a8a',
  description TEXT DEFAULT '',
  created_at TIMESTAMPTZ DEFAULT NOW()
);
ALTER TABLE news_categories ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read categories" ON news_categories FOR SELECT USING (true);
CREATE POLICY "Authenticated manage categories" ON news_categories FOR ALL USING (auth.role() = 'authenticated');

