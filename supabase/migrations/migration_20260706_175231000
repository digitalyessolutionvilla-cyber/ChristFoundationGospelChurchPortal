-- Dynamic Navigation Menus
CREATE TABLE IF NOT EXISTS nav_menus (
  id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
  name TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  location TEXT DEFAULT 'header',
  created_at TIMESTAMPTZ DEFAULT NOW()
);
ALTER TABLE nav_menus ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read menus" ON nav_menus FOR SELECT USING (true);
CREATE POLICY "Authenticated manage menus" ON nav_menus FOR ALL USING (auth.role() = 'authenticated');

CREATE TABLE IF NOT EXISTS nav_menu_items (
  id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
  menu_id UUID REFERENCES nav_menus(id) ON DELETE CASCADE,
  parent_id UUID REFERENCES nav_menu_items(id) ON DELETE CASCADE,
  label TEXT NOT NULL,
  url TEXT NOT NULL DEFAULT '/',
  target TEXT DEFAULT '_self',
  icon TEXT DEFAULT '',
  display_order INT DEFAULT 0,
  is_active BOOLEAN DEFAULT true,
  created_at TIMESTAMPTZ DEFAULT NOW()
);
ALTER TABLE nav_menu_items ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public can read menu items" ON nav_menu_items FOR SELECT USING (true);
CREATE POLICY "Authenticated manage menu items" ON nav_menu_items FOR ALL USING (auth.role() = 'authenticated');

