
-- Create the cfgc-media storage bucket
INSERT INTO storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
VALUES (
  'cfgc-media',
  'cfgc-media',
  true,
  52428800,  -- 50MB limit
  ARRAY['image/jpeg','image/png','image/gif','image/webp','image/svg+xml','video/mp4','video/webm','audio/mpeg','audio/mp3','audio/wav','application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document']
)
ON CONFLICT (id) DO UPDATE SET public = true;

-- Storage RLS policies
CREATE POLICY "Public read cfgc-media"
  ON storage.objects FOR SELECT
  USING (bucket_id = 'cfgc-media');

CREATE POLICY "Authenticated upload cfgc-media"
  ON storage.objects FOR INSERT
  WITH CHECK (bucket_id = 'cfgc-media' AND auth.role() = 'authenticated');

CREATE POLICY "Authenticated update cfgc-media"
  ON storage.objects FOR UPDATE
  USING (bucket_id = 'cfgc-media' AND auth.role() = 'authenticated');

CREATE POLICY "Authenticated delete cfgc-media"
  ON storage.objects FOR DELETE
  USING (bucket_id = 'cfgc-media' AND auth.role() = 'authenticated');

