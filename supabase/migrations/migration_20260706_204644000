INSERT INTO cms_content (key, value) VALUES

('welcome_message',
'Welcome to Christ Foundation Gospel Church (CFGC). We are a Spirit-filled, Word-based church committed to raising believers who are grounded in the Word of God and empowered by the Holy Spirit. Our mission is to preach Christ as the Sure Foundation for victorious Christian living.

We believe in the saving grace of Jesus Christ, the power of the Holy Spirit, and the authority of the Word of God. Our doors are open to all who seek a personal relationship with God.

