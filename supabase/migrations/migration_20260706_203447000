-- quick_links: replaces hardcoded QuickLinks array
CREATE TABLE IF NOT EXISTS quick_links (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  icon_library text NOT NULL DEFAULT 'lucide',
  icon_name text NOT NULL DEFAULT 'Link',
  label text NOT NULL,
  description text DEFAULT '',
  url text NOT NULL DEFAULT '/',
  icon_color text NOT NULL DEFAULT 'text-white',
  bg_color text NOT NULL DEFAULT 'bg-white/20',
  display_order integer NOT NULL DEFAULT 0,
  is_active boolean NOT NULL DEFAULT true,
  created_at timestamptz DEFAULT now(),
  updated_at timestamptz DEFAULT now()
);

ALTER TABLE quick_links ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Public can read quick_links" ON quick_links FOR SELECT USING (true);
CREATE POLICY "Authenticated can manage quick_links" ON quick_links FOR ALL USING (auth.role() = 'authenticated');

