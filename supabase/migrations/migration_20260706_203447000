-- home_sections: controls which sections appear on homepage and in what order
CREATE TABLE IF NOT EXISTS home_sections (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  section_key text NOT NULL,
  label text NOT NULL,
  display_order integer NOT NULL DEFAULT 0,
  is_visible boolean NOT NULL DEFAULT true,
  custom_config jsonb DEFAULT '{}',
  created_at timestamptz DEFAULT now(),
  updated_at timestamptz DEFAULT now()
);

ALTER TABLE home_sections ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Public can read home_sections" ON home_sections FOR SELECT USING (true);
CREATE POLICY "Authenticated can manage home_sections" ON home_sections FOR ALL USING (auth.role() = 'authenticated');

